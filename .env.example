# Database (local Docker — matches docker-compose postgres service)
DATABASE_URL="postgresql://zora:zora@localhost:5432/zora?schema=public"

# Supabase: direct Postgres on port 5432; do not use transaction pooler 6543.
# Configure server credentials in apps/api-rust/.env, based on its example.

# Redis
REDIS_URL="redis://localhost:6379"

# Rust API (pnpm dev:rust loads apps/api-rust/.env)
PORT=3334
WEB_ORIGIN="http://localhost:3000"

# Server-side Supabase authentication (required unless development is explicitly enabled)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Dev auth — opt in locally with NODE_ENV=development and ALLOW_DEV_AUTH=true.
# Keep disabled in production, staging, and shared environments.
NODE_ENV=development
ALLOW_DEV_AUTH=false
# Demo user id (created by db:seed)
DEV_USER_ID="demo_user_zora"

# External APIs
COINGECKO_API_KEY=""
ALCHEMY_API_KEY=""
MORALIS_API_KEY=""

# Frontend: copy apps/web/.env.example separately; Next reads apps/web/.env.local.
# Do not expose provider/service-role keys through NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL="http://localhost:3334"

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
