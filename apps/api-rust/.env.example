# Direct Postgres only. Never use Supavisor transaction pooler port 6543.
DATABASE_URL=postgresql://zora:zora@localhost:5432/zora
DIRECT_URL=postgresql://zora:zora@localhost:5432/zora
REDIS_URL=redis://localhost:6379
# Run beside Fastify (3333).
HOST=0.0.0.0
PORT=3334
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development
# Explicit opt-in for local impersonation only; never enable on shared environments.
ALLOW_DEV_AUTH=false
RUST_LOG=info
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Optional override; defaults to SUPABASE_URL/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
DEV_USER_ID=demo_user_zora
# CoinGecko prices (optional Demo key) and Alchemy read-only tracking.
COINGECKO_API_KEY=
ALCHEMY_API_KEY=
MORALIS_API_KEY=

# Optional: enables NewsData crypto + market. RSS works without this key.
NEWSDATA_API_KEY=
