# Browser-safe Supabase URL and public anon/publishable key.
# The application currently reads the ANON_KEY variable name.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public backend origin. In production use the HTTPS Render service URL.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3334

# Server-only Rust API origins. Use the same Render service URL in production.
MARKET_API_URL=http://127.0.0.1:3334
NEWS_API_URL=http://127.0.0.1:3334
