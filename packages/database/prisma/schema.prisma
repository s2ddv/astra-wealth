generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Chain {
  ETHEREUM
  POLYGON
  ARBITRUM
  BASE
  SOLANA
  BITCOIN
}

enum Exchange {
  COINBASE
  BINANCE
  KRAKEN
  BYBIT
}

enum SnapshotSource {
  WALLET_REFRESH
  SCHEDULED
  MANUAL
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authId String @unique

  accounts            FinancialAccount[]
  openFinanceConnections OpenFinanceConnection[]
  wallets             Wallet[]
  watchlists          Watchlist[]
  snapshots           PortfolioSnapshot[]
  exchangeConnections ExchangeConnection[]

  @@map("users")
}

model Wallet {
  account FinancialAccount?
  id       String  @id @default(uuid())
  address  String
  chain    Chain
  nickname String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assets WalletAsset[]

  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, address, chain])
  @@index([userId])
  @@map("wallets")
}

model WalletAsset {
  id     String  @id @default(uuid())
  symbol String
  name   String?

  contractAddress String?
  isNative        Boolean @default(false)

  amount   Decimal  @db.Decimal(38, 18)
  usdValue Decimal? @db.Decimal(18, 2)

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([walletId, symbol])
  @@index([walletId])
  @@map("wallet_assets")
}

model Watchlist {
  id   String @id @default(uuid())
  name String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items WatchlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@map("watchlists")
}

model WatchlistItem {
  id     String @id @default(uuid())
  coinId String

  watchlistId String
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@unique([watchlistId, coinId])
  @@index([watchlistId])
  @@map("watchlist_items")
}

model PortfolioSnapshot {
  id       String         @id @default(uuid())
  totalUsd Decimal        @db.Decimal(18, 2)
  source   SnapshotSource @default(WALLET_REFRESH)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("portfolio_snapshots")
}

model ExchangeConnection {
  account FinancialAccount?
  id       String   @id @default(uuid())
  exchange Exchange

  encryptedKey    String
  encryptedSecret String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, exchange])
  @@index([userId])
  @@map("exchange_connections")
}

enum AccountKind {
  WALLET
  EXCHANGE
  BANK
  BROKERAGE
  MANUAL
}

enum AssetClass {
  CRYPTO
  STOCK
  REAL_ESTATE_FUND
  ETF
  FIXED_INCOME
  MUTUAL_FUND
  PENSION
  CASH
  OTHER
}

enum ContributionKind {
  DEPOSIT
  WITHDRAWAL
}

enum DataOrigin {
  MANUAL
  IMPORTED
}

enum FiatCurrency {
  BRL
  USD
}

enum OpenFinanceProvider {
  PLUGGY
}

enum ConnectionStatus {
  ACTIVE
  NEEDS_REAUTH
  EXPIRED
  ERROR
}

model OpenFinanceConnection {
  id                String              @id @default(cuid())
  userId            String
  provider          OpenFinanceProvider
  externalItemId    String              // id da conexão no agregador; NUNCA credenciais
  institutionName   String
  status            ConnectionStatus    @default(ACTIVE)
  consentExpiresAt  DateTime?
  lastSyncedAt      DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts FinancialAccount[]

  @@unique([provider, externalItemId])
  @@index([userId])
}

model FinancialAccount {
  id                      String       @id @default(cuid())
  userId                  String
  kind                    AccountKind
  name                    String       // ex.: "Itaú — Investimentos", "Carteira principal"
  institutionName         String?
  baseCurrency            FiatCurrency @default(BRL)
  walletId                String?      @unique
  exchangeConnectionId    String?      @unique
  openFinanceConnectionId String?
  externalAccountId       String?      // id da conta no agregador (Etapa 3)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet                Wallet?                @relation(fields: [walletId], references: [id])
  exchangeConnection    ExchangeConnection?    @relation(fields: [exchangeConnectionId], references: [id])
  openFinanceConnection OpenFinanceConnection? @relation(fields: [openFinanceConnectionId], references: [id])
  holdings              Holding[]
  contributions         Contribution[]

  @@index([userId])
}

model Holding {
  id            String     @id @default(cuid())
  accountId     String
  assetClass    AssetClass
  symbol        String?    // ticker quando existir (PETR4, IVVB11)
  name          String     // ex.: "CDB Banco X 110% CDI"
  quantity      Decimal    @db.Decimal(28, 10)
  unitPrice     Decimal?   @db.Decimal(28, 10)
  currentValue  Decimal    @db.Decimal(28, 10)   // na moeda da conta
  dueDate       DateTime?
  origin        DataOrigin @default(MANUAL)
  externalId    String?
  updatedAt     DateTime   @updatedAt
  createdAt     DateTime   @default(now())

  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, externalId])
  @@index([accountId])
}

model Contribution {
  id          String           @id @default(cuid())
  accountId   String
  kind        ContributionKind
  amount      Decimal          @db.Decimal(28, 10)
  currency    FiatCurrency
  fxRateToBrl Decimal?         @db.Decimal(18, 8)   // cotação no dia, se moeda != BRL
  occurredAt  DateTime
  note        String?
  origin      DataOrigin       @default(MANUAL)
  externalId  String?          // idempotência da importação (Etapa 3)
  createdAt   DateTime         @default(now())

  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, externalId])
  @@index([accountId, occurredAt])
}
